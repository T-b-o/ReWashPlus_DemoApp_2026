<section class="mt-6 mx-4">
    <h2 class="text-white text-lg font-bold mb-3">Nearby Car Washes</h2>

    <div class="bg-clickup-light rounded-2xl overflow-hidden">

        <!--
            Map placeholder.
            Future: replace with Leaflet + OpenStreetMap embed.
            Technician live tracking will be added via SignalR.
        -->
        <div class="bg-clickup-surface h-40 flex flex-col items-center justify-center gap-2">
            <div class="w-12 h-12 rounded-full bg-clickup-dark flex items-center justify-center">
                <i class="fas fa-map text-clickup-accent text-xl"></i>
            </div>
            <p class="text-clickup-muted text-xs text-center leading-relaxed">
                Live map coming soon<br />
                <span class="opacity-60">Leaflet · OpenStreetMap · Live tracking</span>
            </p>
        </div>

        <!-- Nearby car wash list sorted by distance -->
        @foreach (var wash in _locations)
        {
            <div class="p-4 flex items-center gap-4 border-t border-clickup-border">
                <div class="w-10 h-10 bg-clickup-accent/20 rounded-full flex items-center justify-center shrink-0">
                    <i class="fas fa-car-wash text-clickup-accent text-sm"></i>
                </div>
                <div class="flex-1 min-w-0">
                    <p class="text-white font-semibold text-sm truncate">📍 @wash.Name</p>
                    <p class="text-clickup-muted text-xs truncate mt-0.5">@wash.Address</p>
                    <div class="flex items-center gap-1.5 mt-0.5">
                        <span class="w-1.5 h-1.5 rounded-full @(wash.IsOpen ? "bg-green-400" : "bg-red-400")"></span>
                        <span class="@(wash.IsOpen ? "text-green-400" : "text-red-400") text-xs font-semibold">
                            @(wash.IsOpen ? "Open now" : "Closed")
                        </span>
                        <span class="text-clickup-muted text-xs">· @wash.DistanceKm km · @wash.OpenHours</span>
                    </div>
                </div>
                <a href="book?washId=@wash.Id"
                   class="bg-clickup-accent text-white text-xs font-bold px-3 py-2 rounded-xl active:bg-clickup-accentDark transition-colors shrink-0">
                    Book
                </a>
            </div>
        }

    </div>
</section>

@code {
    private static readonly IReadOnlyList<ReWashPlus_DemoApp.Services.CarWashLocation> _locations
        = ReWashPlus_DemoApp.Services.CarWashLocationService.AllLocations;
}
