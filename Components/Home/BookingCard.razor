@using ReWashPlus_DemoApp.Services
@inject CarWashLocationService WashLocations

<div class="mx-4 mt-4">
    <div class="relative bg-gradient-to-br from-cyan-500 to-cyan-600 rounded-2xl p-5 shadow-lg overflow-hidden">

        <!-- Decorative background circles -->
        <div class="absolute -top-6 -right-6 w-28 h-28 bg-white/10 rounded-full"></div>
        <div class="absolute -bottom-4 -left-4 w-20 h-20 bg-white/5 rounded-full"></div>

        <!-- Fast Booking badge -->
        <span class="absolute top-4 right-4 bg-white/20 text-white text-xs font-bold px-3 py-1 rounded-full z-10">
            ⚡ Fast Booking
        </span>

        <!-- Title -->
        <div class="relative z-10 mb-4">
            <p class="text-cyan-100 text-xs font-semibold uppercase tracking-widest mb-1">Ready to go</p>
            <h2 class="text-white text-2xl font-extrabold">🚗 Book a Wash</h2>
        </div>

        <!-- Booking details grid -->
        <div class="relative z-10 grid grid-cols-2 gap-y-3 gap-x-4 mb-5">
            <div>
                <p class="text-cyan-200 text-xs mb-0.5">Vehicle</p>
                <p class="text-white font-semibold text-sm">BMW 320i</p>
            </div>
            <div>
                <p class="text-cyan-200 text-xs mb-0.5">Location</p>
                <p class="text-white font-semibold text-sm">@(_lastWash?.Name ?? "Not selected")</p>
            </div>
            <div>
                <p class="text-cyan-200 text-xs mb-0.5">Service</p>
                <p class="text-white font-semibold text-sm">Deluxe Wash</p>
            </div>
            <div>
                <p class="text-cyan-200 text-xs mb-0.5">Distance</p>
                <p class="text-white font-semibold text-sm">
                    @(_lastWash is not null ? $"{_lastWash.DistanceKm} km away" : "—")
                </p>
            </div>
        </div>

        <!-- CTA button -->
        <a href="@_bookHref"
           class="relative z-10 block w-full bg-white text-cyan-600 text-center font-bold py-3.5 rounded-xl text-base active:bg-gray-50 transition-colors">
            @(_lastWash is not null ? $"Book again at {_lastWash.Name}" : "Select Car Wash & Book")
        </a>

    </div>
</div>

@code {
    private ReWashPlus_DemoApp.Services.CarWashLocation? _lastWash;
    private string _bookHref = "/book";

    protected override async Task OnInitializedAsync()
    {
        var lastId = await WashLocations.GetLastUsedIdAsync();
        _lastWash  = CarWashLocationService.GetById(lastId);
        _bookHref  = _lastWash is not null ? $"/book?washId={_lastWash.Id}" : "/book";
    }
}
