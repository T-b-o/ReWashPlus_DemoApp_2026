@page "/bookings"
@page "/my-bookings"
@using ReWashPlus_DemoApp.Models
@using ReWashPlus_DemoApp.Services

<div class="p-4 sm:p-6 space-y-6">

    <!-- Header + Search + Connectivity -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div class="flex items-center gap-3 flex-wrap">
            <h1 class="text-3xl font-bold text-clickup-accent">Bookings</h1>

            <!-- Connectivity pill -->
            <span class="inline-flex items-center gap-1.5 text-xs font-semibold px-3 py-1 rounded-full
                         @(Connectivity.IsOnline ? "bg-green-400/15 text-green-400" : "bg-red-400/15 text-red-400")">
                <span class="w-1.5 h-1.5 rounded-full @(Connectivity.IsOnline ? "bg-green-400" : "bg-red-400") animate-pulse"></span>
                @(Connectivity.IsOnline ? "Online" : "Offline")
            </span>
        </div>

        <div class="relative w-full sm:w-80">
            <input type="text"
                   class="input pl-10"
                   placeholder="Search by customer or ID..."
                   @bind="SearchTerm"
                   @bind:event="oninput" />
            <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-clickup-accent"></i>
        </div>
    </div>

    <!-- Table -->
    <div class="overflow-x-auto bg-clickup-light border border-clickup-border rounded-xl">
        <table class="min-w-full divide-y divide-clickup-border">
            <thead class="border-b border-clickup-border">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium text-clickup-accent uppercase tracking-wider">Booking ID</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-clickup-accent uppercase tracking-wider">Customer</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-clickup-accent uppercase tracking-wider">Date</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-clickup-accent uppercase tracking-wider">Time</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-clickup-accent uppercase tracking-wider">Status</th>
                    <th class="px-6 py-3 text-right text-xs font-medium text-clickup-accent uppercase tracking-wider">Actions</th>
                </tr>
            </thead>

            <tbody class="divide-y divide-clickup-border">
                @if (!FilteredBookings.Any())
                {
                    <tr>
                        <td colspan="6" class="px-6 py-6 text-center text-sm text-clickup-muted">
                            No bookings found.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var booking in FilteredBookings)
                    {
                        <tr class="hover:bg-clickup-surface transition">
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-clickup-text">@booking.Id</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-clickup-accent">@booking.CustomerName</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-clickup-text">@booking.AppointmentAt.ToString("yyyy-MM-dd")</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-clickup-text">@booking.AppointmentAt.ToString("hh:mm tt")</td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <span class="status-badge @GetStatusBadgeClass(booking.Status)">@booking.Status</span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium flex flex-wrap gap-2 justify-end">
                                <button class="btn-primary flex items-center px-3 py-1 rounded-xl"
                                        @onclick="() => ViewBooking(booking.Id)">
                                    <i class="fas fa-eye mr-2"></i> View
                                </button>
                                <button class="btn-secondary flex items-center px-3 py-1 rounded-xl text-clickup-text"
                                        @onclick="() => EditBooking(booking.Id)">
                                    <i class="fas fa-pen mr-2"></i> Edit
                                </button>
                                <button class="flex items-center px-3 py-1 rounded-xl bg-clickup-red text-white hover:opacity-90 transition"
                                        @onclick="() => CancelBooking(booking.Id)">
                                    <i class="fas fa-times mr-2"></i> Cancel
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
