@page "/"
@inject ReWashPlus_DemoApp.Services.JobService JobService

<!-- ─── Section 1: Greeting header ──────────────────────── -->
<HomeHeader />

<!-- ─── Section 2: Location ──────────────────────────────── -->
<LocationCard />

<!-- ─── Section 3: Main Booking Card ────────────────────── -->
<BookingCard />

<!-- ─── Section 4: Quick Services ───────────────────────── -->
<QuickServices />

<!-- ─── Section 5: Active Booking Status ────────────────── -->
<ActiveBookingStatus IsActive="@_hasActiveBooking"
                     WasherName="Sipho"
                     MinutesRemaining="15"
                     CurrentStep="1" />

<!-- ─── Section 6: Nearby Teams ─────────────────────────── -->
<NearbyTeams />

<!-- ─── Section 7: Membership ───────────────────────────── -->
<MembershipCard />

<div class="h-4"></div>

@code {
    private bool _hasActiveBooking = false;

    protected override async Task OnInitializedAsync()
    {
        var bookings = await JobService.GetAllAsync();
        _hasActiveBooking = bookings.Any(b => b.Status == JobStatus.InProgress);
    }
}
