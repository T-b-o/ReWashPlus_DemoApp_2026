@inherits LayoutComponentBase
@inject ReWashPlus_DemoApp.Services.PageTitleService PageTitleService

<div class="flex h-screen bg-clickup-dark text-clickup-text">

    <!-- Sidebar -->
    <NavMenu />

    <!-- Main Content Area -->
    <div class="bg-clickup-main flex-1 flex flex-col overflow-hidden">

        <!-- Sticky Header -->
        <header class="sticky top-0 z-50 bg-clickup-light rounded-b-2xl flex justify-between items-center px-6 py-4 shadow-clickup">
            <h1 class="text-2xl font-bold text-clickup-accent">@PageTitle</h1>

            <div class="flex items-center gap-4">
                <span class="text-clickup-muted">Hello, @UserName</span>
                <a href="/profile" class="hover:text-clickup-accent transition">
                    <i class="fas fa-user-circle text-2xl"></i>
                </a>
            </div>
        </header>

        <!-- Main Page Content -->
        <main class="flex-1 overflow-y-auto p-6 m-6 bg-clickup-light rounded-3xl shadow-clickup">
            @Body
        </main>
    </div>
</div>

@code {
    private string UserName = "Teboho";
    private string PageTitle => PageTitleService.Title;

    protected override void OnInitialized()
    {
        // Subscribe to title changes so the header updates dynamically
         PageTitleService.TitleChanged += () => InvokeAsync(StateHasChanged);
    }
}
