@inherits LayoutComponentBase
@implements IDisposable
@inject ReWashPlus_DemoApp.Services.PageTitleService PageTitleService
@inject ReWashPlus_DemoApp.Services.ConnectivityService Connectivity
@inject ReWashPlus_DemoApp.Services.AuthService AuthService
@inject NavigationManager Nav

<div class="flex h-screen bg-clickup-dark text-clickup-text overflow-hidden">

    <!-- Sidebar -->
    <NavMenu />

    <!-- Main Content Area -->
    <div class="flex-1 flex flex-col overflow-hidden">

        <!-- Sticky Header -->
        <header class="sticky top-0 z-10 border-b border-clickup-border flex justify-between items-center px-6 py-4">
            <h1 class="text-xl font-semibold text-clickup-text">@PageTitle</h1>

            <div class="flex items-center gap-4">
                <!-- Online / Offline indicator -->
                <span class="@(Connectivity.IsOnline ? "text-green-400" : "text-red-400") text-xs font-medium flex items-center gap-1">
                    <i class="fas @(Connectivity.IsOnline ? "fa-wifi" : "fa-exclamation-triangle")"></i>
                    @(Connectivity.IsOnline ? "Online" : "Offline")
                </span>

                <!-- User greeting -->
                <span class="text-clickup-muted text-sm hidden sm:inline">
                    Hello, <span class="text-clickup-accent font-medium">@DisplayName</span>
                </span>

                <!-- Profile icon -->
                <a href="/profile" class="hover:text-clickup-accent transition" title="Profile">
                    <i class="fas fa-user-circle text-2xl text-clickup-muted"></i>
                </a>

                <!-- Logout -->
                <button @onclick="HandleLogout"
                        class="text-clickup-muted hover:text-red-400 transition"
                        title="Sign out">
                    <i class="fas fa-sign-out-alt text-xl"></i>
                </button>
            </div>
        </header>

        <!-- Main Page Content -->
        <main class="flex-1 overflow-y-auto p-6">
            @Body
        </main>
    </div>
</div>

@code {
    private string PageTitle  => PageTitleService.Title;
    private string DisplayName => AuthService.CurrentUser?.FullName is { Length: > 0 } n ? n
                                   : AuthService.CurrentUser?.Email ?? "Guest";

    private static readonly HashSet<string> PublicPaths = new(StringComparer.OrdinalIgnoreCase)
    {
        "", "/", "/login", "/register", "/register-tenant"
    };

    protected override async Task OnInitializedAsync()
    {
        PageTitleService.TitleChanged    += OnTitleChanged;
        Nav.LocationChanged              += OnLocationChanged;
        AuthService.AuthStateChanged     += OnAuthStateChanged;
        Connectivity.ConnectivityChanged += OnConnectivityChanged;

        UpdateTitle(Nav.Uri);

        try { await Connectivity.InitializeAsync(); } catch { /* non-fatal */ }
        try { await AuthService.InitializeAsync();  } catch { /* non-fatal */ }
    }

    // Navigation guard runs after first render — the only safe place to call
    // NavigateTo from a layout component.
    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) GuardAuth(Nav.Uri);
        return Task.CompletedTask;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        UpdateTitle(e.Location);
        GuardAuth(e.Location);
        InvokeAsync(StateHasChanged);
    }

    private void OnAuthStateChanged()      => InvokeAsync(StateHasChanged);
    private void OnConnectivityChanged()   => InvokeAsync(StateHasChanged);
    private void OnTitleChanged()          => InvokeAsync(StateHasChanged);

    private void GuardAuth(string url)
    {
        var path = new Uri(url).AbsolutePath.TrimEnd('/');
        if (!AuthService.IsAuthenticated && !PublicPaths.Contains(path))
            Nav.NavigateTo("/login", replace: true);
    }

    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        Nav.NavigateTo("/login", replace: true);
    }

    private void UpdateTitle(string url)
    {
        var path  = new Uri(url).AbsolutePath.ToLowerInvariant().TrimEnd('/');
        var title = path switch
        {
            "" or "/"                  => "Home",
            "/book"                    => "Book a Wash",
            "/bookings"
            or "/my-bookings"          => "Bookings",
            "/payments"                => "Payments",
            "/notifications"           => "Notifications",
            "/profile"                 => "Profile",
            "/admin/dashboard"         => "Admin Dashboard",
            "/admin/manage-bookings"   => "Manage Bookings",
            "/admin/manage-payments"   => "Manage Payments",
            "/admin/users"             => "Users",
            "/admin/reports"           => "Reports",
            "/admin/settings"          => "Settings",
            _                          => "ReWash+"
        };
        PageTitleService.SetTitle(title);
    }

    public void Dispose()
    {
        Nav.LocationChanged              -= OnLocationChanged;
        AuthService.AuthStateChanged     -= OnAuthStateChanged;
        Connectivity.ConnectivityChanged -= OnConnectivityChanged;
        PageTitleService.TitleChanged    -= OnTitleChanged;
    }
}
