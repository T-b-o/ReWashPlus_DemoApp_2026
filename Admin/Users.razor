@page "/admin/users"
@using ReWashPlus_DemoApp.Services
@inject ReWashPlus_DemoApp.Services.PageTitleService PageTitleService

<div class="p-6 bg-clickup-dark min-h-screen text-clickup-text">
    <h1 class="text-2xl font-bold text-clickup-accent">Users</h1>
    <p class="text-sm text-clickup-muted">Admin user management UI.</p>
</div>

@code {
    protected override void OnInitialized()
    {
        PageTitleService.TitleChanged += () => InvokeAsync(StateHasChanged);
    }
}