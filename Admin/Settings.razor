@page "/admin/settings"
@using ReWashPlus_DemoApp.Services
@inject ReWashPlus_DemoApp.Services.PageTitleService PageTitleService

<div class="p-6">
    <h1 class="text-2xl font-bold text-clickup-accent">Settings</h1>
    <p class="text-sm text-clickup-muted">Application settings and configuration.</p>
</div>

@code {
    protected override void OnInitialized()
    {
        PageTitleService.TitleChanged += () => InvokeAsync(StateHasChanged);
    }
}